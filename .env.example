# Env vars — copy to .env.local and fill in real values
# NEVER commit .env.local to git

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# QR HMAC secret (also store in Supabase secrets for Edge Functions)
VITE_QR_HMAC_SECRET=generate-a-random-64-char-hex-string

# Brevo API key — store ONLY in Supabase secrets, NOT here
# BREVO_API_KEY=xkeysib-...
